$HOME/projects/themes/dist/userChrome.css
/* color options */
:root {
  /* text colors */
  --text-0: var(--bg-4); /* text on colored elements */
  --text-1: %(l-adj "2" "$fg" | fhex)%; /* other normally white text */
  --text-2: %(l-adj "1" "$fg" | fhex)%; /* headings and important text */
  --text-3: %(fhex "$fg")%; /* normal text */
  --text-4: %(l-adj "-1" "$fg" | fhex)%; /* icon buttons and channels */
  --text-5: %(l-adj "-2" "$fg" | fhex)%; /* muted channels/chats and timestamps */

  /* background and dark colors */
  --bg-1: %(l-adj "3" "$bg" | fhex)%; /* dark buttons when clicked */
  --bg-2: %(l-adj "2" "$bg" | fhex)%; /* dark buttons */
  --bg-3: %(l-adj "1" "$bg" | fhex)%; /* spacing, secondary elements */
  --bg-4: %(fhex "$bg")%; /* main background color */

  /* accent colors */
  --accent-1: %(fhex "$accent")%; /* links and other accent text */
  --accent-2: %(l-adj "-1" "$accent" | fhex)%; /* small accent elements */
  --accent-3: %(l-adj "-2" "$accent" | fhex)%; /* accent buttons */
  --accent-4: %(l-adj "-3" "$accent" | fhex)%; /* accent buttons when hovered */
  --accent-5: %(l-adj "-4" "$accent" | fhex)%; /* accent buttons when clicked */

  /* base colors */
  --red-1: %(fhex "$red")%;
  --red-2: %(l-adj "-1" "$red" | fhex)%;
  --red-3: %(l-adj "-2" "$red" | fhex)%;
  --red-4: %(l-adj "-3" "$red" | fhex)%;
  --red-5: %(l-adj "-4" "$red" | fhex)%;

  --green-1: %(fhex "$green")%;
  --green-2: %(l-adj "-1" "$green" | fhex)%;
  --green-3: %(l-adj "-2" "$green" | fhex)%;
  --green-4: %(l-adj "-3" "$green" | fhex)%;
  --green-5: %(l-adj "-4" "$green" | fhex)%;

  --blue-1: %(fhex "$blue")%;
  --blue-2: %(l-adj "-1" "$blue" | fhex)%;
  --blue-3: %(l-adj "-2" "$blue" | fhex)%;
  --blue-4: %(l-adj "-3" "$blue" | fhex)%;
  --blue-5: %(l-adj "-4" "$blue" | fhex)%;

  --yellow-1: %(fhex "$yellow")%;
  --yellow-2: %(l-adj "-1" "$yellow" | fhex)%;
  --yellow-3: %(l-adj "-2" "$yellow" | fhex)%;
  --yellow-4: %(l-adj "-3" "$yellow" | fhex)%;
  --yellow-5: %(l-adj "-4" "$yellow" | fhex)%;

  --purple-1: %(fhex "$magenta")%;
  --purple-2: %(l-adj "-1" "$magenta" | fhex)%;
  --purple-3: %(l-adj "-2" "$magenta" | fhex)%;
  --purple-4: %(l-adj "-3" "$magenta" | fhex)%;
  --purple-5: %(l-adj "-4" "$magenta" | fhex)%;

  --toolbox-background-color: var(--bg-4) !important;
  --toolbox-background-color-inactive: var(--bg-4) !important;
  --toolbox-text-color: var(--text-3) !important;
  --toolbox-text-color-inactive: var(--text-3) !important;
  --tab-selected-textcolor: var(--text-2) !important;

  --toolbar-background-color: var(--bg-3) !important;
  --tab-background-color-selected: var(--bg-3) !important;
  --toolbarbutton-icon-fill: var(--text-3) !important;
  --toolbar-text-color: var(--text-3) !important;

  --focus-outline-color: var(--accent-1) !important;
  
  /* Buttons */
  --button-background-color: var(--bg-2) !important;
  --urlbar-box-background-color: var(--bg-2) !important;

  /* Address Bar */
  --toolbar-field-text-color: var(--accent-1) !important;
  --toolbar-field-text-color-focus: var(--accent-1) !important;
  --toolbar-field-background-color: rgba(0, 0, 0, 0.0) !important;
  --toolbar-field-background-color-focus: var(--bg-3) !important;

  /* Panels */
  --panel-background-color: var(--bg-4) !important;
  --panel-text-color: var(--text-3) !important;
  --panel-border-color: var(--bg-2) !important;

  /* Tab Groups */
  --tab-group-label-text-dark: var(--bg-4) !important;
  
  --tab-group-color-blue: rgba(0, 0, 0, 0.0) !important;
  --tab-group-color-blue-invert: var(--text-3) !important;
  --tab-group-color-blue-pale: var(--text-3) !important;
  
  --tab-group-color-purple: rgba(0, 0, 0, 0.0) !important;
  --tab-group-color-purple-invert: var(--text-3) !important;
  --tab-group-color-purple-pale: var(--text-3) !important;
  
  --tab-group-color-cyan: rgba(0, 0, 0, 0.0) !important;
  --tab-group-color-cyan-invert: var(--text-3) !important;
  --tab-group-color-cyan-pale: var(--text-3) !important;
  
  --tab-group-color-orange: rgba(0, 0, 0, 0.0) !important;
  --tab-group-color-orange-invert: var(--text-3) !important;
  --tab-group-color-orange-pale: var(--text-3) !important;
  
  --tab-group-color-yellow: rgba(0, 0, 0, 0.0) !important;
  --tab-group-color-yellow-invert: var(--text-3) !important;
  --tab-group-color-yellow-pale: var(--text-3) !important;
  
  --tab-group-color-pink: rgba(0, 0, 0, 0.0) !important;
  --tab-group-color-pink-invert: var(--text-3) !important;
  --tab-group-color-pink-pale: var(--text-3) !important;
  
  --tab-group-color-green: rgba(0, 0, 0, 0.0) !important;
  --tab-group-color-green-invert: var(--text-3) !important;
  --tab-group-color-green-pale: var(--text-3) !important;
  
  --tab-group-color-gray: rgba(0, 0, 0, 0.0) !important;
  --tab-group-color-gray-invert: var(--text-3) !important;
  --tab-group-color-gray-pale: var(--text-3) !important;
  
  --tab-group-color-red: rgba(0, 0, 0, 0.0) !important;
  --tab-group-color-red-invert: var(--text-3) !important;
  --tab-group-color-red-pale: var(--text-3) !important;
}
